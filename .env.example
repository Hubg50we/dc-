# Discord Multi-Account Configuration
# Device appearance: "mobile" (shows 📱 phone icon on Discord) or "desktop" (shows 🟢 dot)
DEVICE_TYPE=mobile

# Target Discord Server (Guild) ID
GUILD_ID=YOUR_GUILD_ID

# Default Voice Channel ID
CHANNEL_ID=YOUR_CHANNEL_ID

# Optional command poll file (useful when running in background)
COMMAND_FILE=commands.txt

# Comma-separated list of tokens (optional: you can also put them in tokens.txt)
TOKENS=

# --- Security ---------------------------------------------------------------
# Master dashboard password. CHANGE THIS before exposing the dashboard.
DC_ACCESS_KEY=
# Key used to encrypt tokens.txt and the local .dc_secret file.
# Set this in containers/cloud so encrypted tokens survive restarts.
DC_SECRET_KEY=
# Allow shell commands through the dashboard (admin only). Keep disabled.
DC_ALLOW_SHELL=false
# Allow unauthenticated credential recovery at login. Keep disabled.
DC_ALLOW_AUTH_AUTOHEAL=false
# Login brute-force protection.
DC_LOGIN_MAX_FAILS=8
DC_LOGIN_LOCKOUT_SECONDS=300
# Disable the dashboard key system only on trusted local machines.
KEY_SYSTEM_ENABLED=true
